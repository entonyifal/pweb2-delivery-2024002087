generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Motorista {
  id     Int       @id @default(autoincrement())
  nome   String
  cpf    String    @unique
  status String    @default("ATIVO")
  
  entregas Entrega[]
}

model Entrega {
  id          Int      @id @default(autoincrement())
  descricao   String
  origem      String
  destino     String
  status      String   @default("CRIADA")
  
  motoristaId Int?
  motorista   Motorista? @relation(fields: [motoristaId], references: [id])
  
  historico   Historico[]
}

model Historico {
  id        Int      @id @default(autoincrement())
  status    String
  evento    String?
  data      String
  
  entregaId Int
  entrega   Entrega  @relation(fields: [entregaId], references: [id])
}