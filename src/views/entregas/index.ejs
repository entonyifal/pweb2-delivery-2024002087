<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Entregas</h2>
    <a href="/entregas/nova" class="btn btn-primary">Nova Entrega</a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form action="/entregas" method="GET" class="d-flex gap-2 align-items-center">
            <label for="status" class="form-label mb-0 fw-bold">Filtrar por Status:</label>
            <select name="status" id="status" class="form-select w-auto">
                <option value="">Todas</option>
                <option value="CRIADA" <%= statusFiltro === 'CRIADA' ? 'selected' : '' %>>CRIADA</option>
                <option value="EM_TRANSITO" <%= statusFiltro === 'EM_TRANSITO' ? 'selected' : '' %>>EM_TRANSITO</option>
                <option value="ENTREGUE" <%= statusFiltro === 'ENTREGUE' ? 'selected' : '' %>>ENTREGUE</option>
                <option value="CANCELADA" <%= statusFiltro === 'CANCELADA' ? 'selected' : '' %>>CANCELADA</option>
            </select>
            <button type="submit" class="btn btn-secondary">Filtrar</button>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Descrição</th>
                    <th>Origem</th>
                    <th>Destino</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% if (entregas && entregas.length > 0) { %>
                    <% entregas.forEach(e => { %>
                        <tr>
                            <td><%= e.id %></td>
                            <td><%= e.descricao %></td>
                            <td><%= e.origem %></td>
                            <td><%= e.destino %></td>
                            <td>
                                <span class="badge bg-<%= e.status === 'ENTREGUE' ? 'success' : (e.status === 'CANCELADA' ? 'danger' : 'warning') %>">
                                    <%= e.status %>
                                </span>
                            </td>
                            <td>
                                <a href="/entregas/<%= e.id %>" class="btn btn-sm btn-info text-white">Detalhes</a>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Nenhuma entrega encontrada.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>