<div class="card shadow-sm max-w-md mx-auto" style="max-width: 600px;">
    <div class="card-header bg-dark text-white">
        <h4 class="mb-0">Cadastrar Motorista</h4>
    </div>
    <div class="card-body">
        <form action="/motoristas" method="POST">
            <div class="mb-3">
                <label for="nome" class="form-label">Nome Completo</label>
                <input type="text" class="form-control" id="nome" name="nome" value="<%= dadosAntigos.nome || '' %>" required>
            </div>
            
            <div class="mb-4">
                <label for="cpf" class="form-label">CPF</label>
                <input type="text" class="form-control" id="cpf" name="cpf" value="<%= dadosAntigos.cpf || '' %>" required>
            </div>
            
            <div class="d-flex justify-content-between">
                <a href="/motoristas" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-success">Salvar Motorista</button>
            </div>
        </form>
    </div>
</div>