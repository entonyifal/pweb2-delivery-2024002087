<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Motoristas</h2>
    <a href="/motoristas/novo" class="btn btn-primary">Novo Motorista</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>CPF</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% if (motoristas && motoristas.length > 0) { %>
                    <% motoristas.forEach(m => { %>
                        <tr>
                            <td><%= m.id %></td>
                            <td><%= m.nome %></td>
                            <td><%= m.cpf %></td>
                            <td>
                                <span class="badge bg-<%= m.status === 'ATIVO' ? 'success' : 'secondary' %>">
                                    <%= m.status %>
                                </span>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">Nenhum motorista cadastrado ainda.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>